{
  "expo": {
    "name": "PoquitoTalk",
    "slug": "poquitotalk",
    "version": "1.5.4",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "poquitotalk",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.heroapps.poquitotalk",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "audio/*"
            },
            {
              "mimeType": "application/ogg"
            },
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-status-bar",
      "expo-audio",
      [
        "@layers/expo",
        {
          "ios": {
            "attUsageDescription": "Helps measure voice translation improvements and community app growth."
          }
        }
      ]
    ]
  }
}
