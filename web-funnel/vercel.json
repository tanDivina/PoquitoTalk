{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/es", "destination": "/index-es.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/talk", "destination": "/talk.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
